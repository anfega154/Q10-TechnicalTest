@model IEnumerable<Q10_TechnicalTest.Models.Student>

<h2>Estudiantes</h2>
<a asp-action="Create">Nuevo estudiante</a>

<table class="table">
    <tr>
        <th>Nombre</th>
        <th>Documento</th>
        <th>Email</th>
    </tr>
@foreach (var s in Model)
{
    <tr>
        <td>@s.Name</td>
        <td>@s.Document</td>
        <td>@s.Email</td>
    </tr>
}
</table>

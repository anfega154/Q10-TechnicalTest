@page
@model Q10_TechnicalTest.Web.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Gestión de Estudiantes";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row bg-gradient-primary text-white py-4 mb-4 rounded-3" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-1">
                        <i class="fas fa-graduation-cap me-3"></i>@ViewData["Title"]
                    </h1>
                    <p class="mb-0 opacity-75">Administra la información de todos los estudiantes registrados</p>
                </div>
                <a asp-page="Create" class="btn btn-light btn-lg px-4 py-2 rounded-pill shadow-sm hover-btn">
                    <i class="fas fa-user-plus me-2"></i>Registrar Estudiante
                </a>
            </div>
        </div>
    </div>

    <!-- Search Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form method="get">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-0" 
                                   asp-for="SearchString" 
                                   placeholder="Buscar por nombre, documento o email..." />
                            <button type="submit" class="btn btn-primary px-4 rounded-end-pill">
                                <i class="fas fa-search me-2"></i>Buscar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-0 py-3">
                    <h5 class="mb-0 text-primary">
                        <i class="fas fa-users me-2"></i>Lista de Estudiantes
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th class="py-3 px-4">
                                        <i class="fas fa-user me-2"></i>Nombre Completo
                                    </th>
                                    <th class="py-3">
                                        <i class="fas fa-id-card me-2"></i>Documento
                                    </th>
                                    <th class="py-3">
                                        <i class="fas fa-envelope me-2"></i>Correo Electrónico
                                    </th>
                                    <th class="py-3 text-center">
                                        <i class="fas fa-cogs me-2"></i>Acciones
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Students)
                                {
                                    <tr class="student-row">
                                        <td class="py-3 px-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-3">
                                                    @item.Name.Substring(0, 1).ToUpper()
                                                </div>
                                                <strong>@item.Name</strong>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="badge bg-light text-dark fs-6">@item.Document</span>
                                        </td>
                                        <td class="py-3">
                                            <a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a>
                                        </td>
                                        <td class="py-3 text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-page="./Detail" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-info btn-sm rounded-pill me-1" 
                                                   title="Ver detalles">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-page="./Edit" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-warning btn-sm rounded-pill me-1" 
                                                   title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-danger btn-sm rounded-pill" 
                                                   title="Eliminar">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination Section -->
    <div class="row mt-4">
        <div class="col-12">
            <partial name="_PaginationPartial" model="Model.Students" />
        </div>
    </div>
</div>

<style>
    .hover-btn {
        transition: all 0.3s ease;
    }
    
    .hover-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }
    
    .student-row {
        transition: all 0.2s ease;
    }
    
    .student-row:hover {
        background-color: #f8f9ff !important;
        transform: scale(1.01);
    }
    
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
    }
    
    .btn-group .btn {
        transition: all 0.2s ease;
    }
    
    .btn-group .btn:hover {
        transform: scale(1.1);
    }
    
    .card {
        transition: box-shadow 0.3s ease;
    }
    
    .card:hover {
        box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
    }
</style>